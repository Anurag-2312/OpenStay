<% layout("/layouts/boilerplate") %>
<div class="row">
  <div class="col-lg-8 col-md-10 col-12 offset-lg-2 offset-md-1">
    <div class="form-card">
      <h3 class="form-title">Create a new listing</h3>
      <p class="form-subtitle">Tell guests what makes your place special.</p>
      <form
        action="/listings"
        method="POST"
        class="needs-validation"
        novalidate
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input name="listing[title]" type="text" class="form-control" placeholder="Add a catchy title" required />
          <div class="invalid-feedback">Title is required</div>
        </div>
        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea name="listing[description]" class="form-control" placeholder="What makes your place special?" required></textarea>
          <div class="invalid-feedback">Please add a description</div>
        </div>
        <div class="mb-3">
          <label for="image" class="form-label">Listing image</label>
          <input name="listing[image]" type="file" class="form-control" required />
        </div>
        <div class="mb-3">
          <label for="category" class="form-label">Category</label>
          <select name="listing[category]" class="form-select">
            <option value="">Select a category (optional)</option>
            <option value="trending">Trending</option>
            <option value="rooms">Rooms</option>
            <option value="iconic-cities">Iconic cities</option>
            <option value="mountains">Mountains</option>
            <option value="castles">Castles</option>
            <option value="amazing-pools">Amazing pools</option>
            <option value="camping">Camping</option>
            <option value="farms">Farms</option>
            <option value="arctic">Arctic</option>
          </select>
        </div>
        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price (₹)</label>
            <input name="listing[price]" placeholder="1200" type="number" class="form-control" required />
            <div class="invalid-feedback">Price is required</div>
          </div>
          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" placeholder="India" type="text" class="form-control" required />
            <div class="invalid-feedback">Country is required</div>
          </div>
        </div>
        <div class="mb-4">
          <label for="location" class="form-label">Location</label>
          <input name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required />
          <div class="invalid-feedback">Location is required</div>
        </div>
        <button class="btn add-btn" type="submit">Publish listing</button>
      </form>
    </div>
  </div>
</div>
