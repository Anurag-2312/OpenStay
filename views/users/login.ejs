<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
  <div class="auth-card">
    <h2 class="auth-title">Welcome back</h2>
    <p class="auth-subtitle">Log in to continue exploring stays</p>
    <form action="/login" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input id="email" name="email" type="email" class="form-control" required autofocus />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" type="password" class="form-control" required />
      </div>
      <button class="btn auth-btn w-100" type="submit">Log in</button>
    </form>
    <div class="auth-meta">
      <a href="/forgot">Forgot password?</a>
      <span>New to OpenStay? <a href="/signup">Sign up</a></span>
    </div>
  </div>
</div>
