<% layout("/layouts/boilerplate") %>
<div class="auth-wrapper">
  <div class="auth-card">
    <h2 class="auth-title">Create your account</h2>
    <p class="auth-subtitle">Join OpenStay to book and host stays</p>
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input id="username" name="username" type="text" class="form-control" required autofocus />
      </div>
      <div class="mb-3">
        <label for="email" class="form-label">Email</label>
        <input id="email" name="email" type="email" class="form-control" required />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" type="password" class="form-control" required minlength="6" />
      </div>
      <button class="btn auth-btn w-100" type="submit">Sign up</button>
    </form>
    <div class="auth-meta">
      <span>Already have an account? <a href="/login">Log in</a></span>
    </div>
  </div>
</div>
