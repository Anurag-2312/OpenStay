<% layout("/layouts/boilerplate") %>
<div class="row mt-4">
  <div class="col-lg-6 col-md-8 col-12 offset-lg-3 offset-md-2 show-page-section">
    <h3 class="mb-1"><%= listing.title %></h3>
    <% if (listing.owner) { %>
      <p class="owner-line"><i class="fa-regular fa-user"></i> Hosted by <strong><%= listing.owner.username %></strong></p>
    <% } %>
  </div>

  <div class="card col-lg-6 col-md-8 col-12 offset-lg-3 offset-md-2 show-card listing-card">
    <img
      src="<%= listing.image.url %>"
      class="card-img-top show-img"
      alt="listing_image"
    />
    <div class="card-body">
      <p class="card-text mb-2"><%= listing.description %></p>
      <p class="card-text mb-1"><strong>&#8377; <%= listing.price.toLocaleString("en-IN") %></strong> / night</p>
      <p class="card-text text-muted mb-0">
        <i class="fa-solid fa-location-dot me-1"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>
    </div>
  </div>
</div>

<% if (currentUser && listing.owner && listing.owner.equals(currentUser._id)) { %>
  <div class="row">
    <div class="col-lg-6 col-md-8 col-12 offset-lg-3 offset-md-2 show-page-section">
      <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn">
          <i class="fa-solid fa-pen me-1"></i> Edit
        </a>
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
          <button class="btn">
            <i class="fa-solid fa-trash me-1"></i> Delete
          </button>
        </form>
      </div>
    </div>
  </div>
<% } %>

<div class="row mt-4">
  <div class="col-lg-6 col-md-8 col-12 offset-lg-3 offset-md-2 show-page-section">
    <% if (currentUser) { %>
      <h4 class="section-heading">Leave a review</h4>
      <div class="review-form-card">
        <form
          action="/listings/<%= listing._id %>/reviews"
          method="POST"
          class="needs-validation"
          novalidate
        >
          <div class="mb-3">
            <label class="form-label">Rating</label>
            <fieldset class="starability-heart">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3">
            <label for="comment" class="form-label">Comment</label>
            <textarea name="review[comment]" rows="3" class="form-control" placeholder="How was your stay?" required></textarea>
          </div>
          <button class="btn review-submit" type="submit">Post review</button>
        </form>
      </div>
    <% } %>

    <% if (listing.reviews && listing.reviews.length) { %>
      <h4 class="section-heading">All reviews <span class="reviews-count">(<%= listing.reviews.length %>)</span></h4>
      <% for (let review of listing.reviews) { %>
        <div class="card review-item">
          <div class="card-body">
            <% if (review.author) { %>
              <p class="review-author">@<%= review.author.username %></p>
            <% } %>
            <p class="starability-result" data-rating="<%= review.rating %>"></p>
            <p class="review-comment"><%= review.comment %></p>
            <% if (currentUser && review.author && review.author.equals(currentUser._id)) { %>
              <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                <button class="btn btn-sm review-delete" type="submit">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% } %>
    <% } %>
  </div>
</div>

<% if (listing.geometry && listing.geometry.coordinates && listing.geometry.coordinates.length === 2) { %>
  <div class="row mt-3 mb-4">
    <div class="col-lg-6 col-md-8 col-12 offset-lg-3 offset-md-2 show-page-section">
      <h5 class="section-heading mt-0">Where you'll be</h5>
      <div id="map" class="map-box"></div>
    </div>
  </div>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    const coords = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const labelText = <%- JSON.stringify(listing.location + ", " + listing.country) %>;
    const map = L.map("map", { scrollWheelZoom: false }).setView([coords[1], coords[0]], 11);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "&copy; OpenStreetMap"
    }).addTo(map);
    L.marker([coords[1], coords[0]]).addTo(map).bindPopup(labelText).openPopup();
  </script>
<% } %>
